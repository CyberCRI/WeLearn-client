#!/bin/sh
# runs the ci `lint-and-test` checks (api contract included) before pushing
# e2e tests are left to ci, they make every push too slow
# also refuses pushes to main
# skip once with `git push --no-verify`
set -e

head_sha=$(git rev-parse HEAD)
has_code=false

# git sends one line per pushed ref: <local ref> <local sha> <remote ref> <remote sha>
# an all-zero sha means the ref doesn't exist on that side
while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = refs/heads/main ]; then
    echo "pre-push: pushing to main is not allowed, push a branch and open a pull request"
    exit 1
  fi

  # deleting a ref pushes no code
  case "$local_sha" in *[!0]*) ;; *) continue ;; esac
  has_code=true

  if [ "$(git rev-parse "$local_sha^{commit}" 2>/dev/null)" != "$head_sha" ]; then
    echo "pre-push: warning, $local_ref is not the checked-out commit, the checks below run on HEAD"
  fi
done

$has_code || exit 0

# the checks run on the working tree, so it has to match what is pushed:
# untracked files count too, a file that was never added passes here and fails in ci
if [ -n "$(git status --porcelain)" ]; then
  echo "pre-push: uncommitted or untracked files, commit, stash or delete them first (or push with --no-verify)"
  git status --short
  exit 1
fi

echo "pre-push: lint"
yarn -s lint:check

echo "pre-push: format"
yarn -s format:check

echo "pre-push: type check"
yarn -s type-check

echo "pre-push: unit tests and coverage"
yarn -s test:coverage

echo "pre-push: api contract"
OPENAPI_URL=https://raw.githubusercontent.com/CyberCRI/WeLearn-api/main/openapi.json
if [ "$(curl -s -o /dev/null -w "%{http_code}" "$OPENAPI_URL")" = "404" ]; then
  echo "no openapi.json on WeLearn-api main yet, skipping"
else
  yarn -s gen:api
  git diff --exit-code src/types/generated || {
    echo "pre-push: src/types/generated is out of date with WeLearn-api main, commit the regenerated types"
    exit 1
  }
fi
